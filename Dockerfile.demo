# Records docs/demo.gif by running `airprowl --demo` under vhs.
# Driven by scripts/record-demo.sh — not part of the normal build.

FROM rust:1-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    libdbus-1-dev libusb-1.0-0-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN cargo build --release

FROM ghcr.io/charmbracelet/vhs
RUN apt-get update && apt-get install -y --no-install-recommends \
    libdbus-1-3 libusb-1.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/target/release/airprowl /usr/local/bin/airprowl
COPY demo.tape /demo.tape
WORKDIR /out
ENTRYPOINT ["vhs", "/demo.tape"]
