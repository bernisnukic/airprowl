# vhs tape for the README demo — see scripts/record-demo.sh
Output demo.gif

Set Shell bash
Set FontSize 15
Set Width 1200
Set Height 720
Set Padding 16
Set Framerate 24

Hide
Type "airprowl --demo"
Enter
Sleep 1500ms
Show

Sleep 5s
Tab
Sleep 4s
Tab
Sleep 4s
Type "s"
Sleep 1500ms
Tab
Sleep 3s
Type "q"
Sleep 600ms
